{
  "manifest_version": 3,
  "name": "Plateia",
  "version": "0.9.3",
  "default_locale": "en",
  "description": "__MSG_descricao__",
  "author": "Dreds",
  "homepage_url": "https://github.com/DredsGG",
  "permissions": [
    "storage",
    "alarms"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "src/comum.js",
        "src/i18n/en.js",
        "src/i18n/es.js",
        "src/changelog/pt.js",
        "src/changelog/en.js",
        "src/changelog/es.js",
        "src/vendor/qrcode.js",
        "src/pix.js",
        "src/ui.js",
        "src/pokeidle-painel.js",
        "src/bau.js",
        "src/sala.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "src/comum.js",
        "src/i18n/en.js",
        "src/i18n/es.js",
        "src/changelog/pt.js",
        "src/changelog/en.js",
        "src/changelog/es.js",
        "src/vendor/qrcode.js",
        "src/pix.js",
        "src/ui.js",
        "src/pokeidle-painel.js",
        "src/kick/kick.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "src/pokeidle-ponte.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "src/comum.js",
        "src/pokeidle-guarda.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://kick.com/*"
      ],
      "js": [
        "src/visivel.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://kick.com/*",
    "https://api.github.com/*",
    "https://gql.twitch.tv/*",
    "https://web.kick.com/*"
  ],
  "background": {
    "service_worker": "src/fundo.js",
    "scripts": [
      "src/fundo.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "plateia@dredsgg",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/DredsGG/plateia/main/firefox/updates.json"
    }
  }
}

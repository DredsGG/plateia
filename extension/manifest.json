{
  "manifest_version": 3,
  "name": "Plateia",
  "version": "0.2.2",
  "description": "Twitch: pega o baú de pontos sozinho, resgata Drops e junta várias lives numa sala só. Segue os canais com bônus do PokeIdle. Feito por Dreds.",
  "author": "Dreds",
  "homepage_url": "https://github.com/DredsGG",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "src/comum.js",
        "src/bau.js",
        "src/sala.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "src/pokeidle-ponte.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "src/comum.js",
        "src/pokeidle-guarda.js"
      ],
      "run_at": "document_start"
    }
  ]
}